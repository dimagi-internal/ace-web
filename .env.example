# ace-web local .env template.
#
# Copy to .env and fill in the CommCare Connect OAuth credentials if you
# want to exercise the OAuth login flow locally. `.env` is gitignored.
#
# For local testing without OAuth, leave these empty — the sign-in page
# shows a "Sign in as test user" form (gated on DEBUG=True and
# ACE_ALLOW_TEST_LOGIN=True, both on by default in development.py).

# CommCare Connect OAuth (optional for local dev)
CONNECT_PRODUCTION_URL=https://connect.dimagi.com
CONNECT_OAUTH_CLIENT_ID=
CONNECT_OAUTH_CLIENT_SECRET=

# URL path prefix. Defaults to /ace in docker-compose.yml so local dev
# mirrors the production URL structure. Explicitly set to empty here if
# you prefer to run at the bare root locally (http://localhost:8000/).
# FORCE_SCRIPT_NAME=

# ──── Optional knobs (informational — set only if you want to override) ────
#
# These are NOT required to start the app. They're listed here so you
# know they exist and what they unlock.
#
# Dev-only login bypass — POST email to /auth/test-login/ to create &
# log in a user without OAuth. Default True in development.py; ignored
# unless DEBUG=True. URL is not registered in production.
# ACE_ALLOW_TEST_LOGIN=True
#
# Use a deterministic in-process backend instead of shelling out to
# claude CLI. Default True in development.py. Lets chat work without a
# real Claude subscription. Flip to False to talk to a real Claude.
# ACE_USE_FAKE_CLI_BACKEND=True
#
# Google service-account key JSON (single-line, no newlines) for Drive
# access — opps, workspaces, ingest. Without this, every Drive call
# returns "drive-not-configured". Get the same SA key the team uses
# from 1Password, or wire your own. Empty in local dev by default.
# ACE_DRIVE_SA_KEY_JSON={"type":"service_account",...}
#
# Drive root folder ID for the dev workspace. Defaults to the shared
# Dimagi Team folder (a Drive URL fragment, not a secret) — a fresh
# local DB comes up with the same opps in `Dimagi Team` once you also
# set ACE_DRIVE_SA_KEY_JSON above. Override to point local dev at a
# different folder.
# ACE_DRIVE_ROOT_FOLDER_ID=1HThsA_0Lr5p1OdI5r-aQ446HlNBaySLz
#
# Anthropic API key — fallback when no claude CLI credentials are
# configured. Most users don't need this; CLI subscription is preferred.
# ANTHROPIC_API_KEY=
#
# Restrict logins to specific email domains. Empty = allow any email
# (workspace membership is the real access gate). Set to a non-empty
# list to revert to allowlisted signups, e.g. "dimagi.com,example.org".
# ACE_ALLOWED_EMAIL_DOMAINS=
#
# Token-gated automation login at /auth/e2e-login/ for scripted tools
# (walkthroughs, smoke tests). URL is registered only when this is
# non-empty. Use the ace@dimagi-ai.com bot identity in scripts.
# ACE_E2E_AUTH_TOKEN=
#
# ElevenLabs API key used by the video renderer's per-beat voiceover
# synthesis (`npm run render` from video-production/connect-videos/).
# Without this the renderer silently emits a silent track; the audio
# library never grows. 1Password reference (Engineering vault):
# `op read "op://Engineering/ElevenLabs API/credential"`.
# ELEVENLABS_API_KEY=
