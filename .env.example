# ace-web local .env template.
#
# Copy to .env and fill in the CommCare Connect OAuth credentials if you
# want to exercise the OAuth login flow locally. `.env` is gitignored.
#
# For local testing without OAuth, leave these empty — the login page will
# render but clicking "Sign in" produces a configuration error. You can
# still use /admin/ after creating a superuser.

# CommCare Connect OAuth (optional for local dev)
CONNECT_PRODUCTION_URL=https://connect.dimagi.com
CONNECT_OAUTH_CLIENT_ID=
CONNECT_OAUTH_CLIENT_SECRET=

# URL path prefix. Set to /ace in prod (via connectlabs.py settings).
# In local dev, leave empty for http://localhost:8000/ , OR set to /ace to
# mirror prod URLs — in which case visit http://localhost:8000/ace/
FORCE_SCRIPT_NAME=
