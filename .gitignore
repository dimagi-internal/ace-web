e2e-test.sqlite3

# Bun lockfile — frontend uses bun but the repo conventionally doesn't
# track lockfiles (package.json is the source of truth for pinned versions)
frontend/bun.lock
.gstack/
.claude/settings.local.json

# docker-compose.override.yml is the standard escape hatch for per-developer
# local dev tweaks (plugin live-mount, custom port mappings, etc.). A
# tracked template lives at docker-compose.override.yml.example.
docker-compose.override.yml
.claude/scheduled_tasks.lock
qa-results/

# Per-run render scratch. Drive is the source of truth for spec.yaml,
# output.mp4, and the explorer artifacts (see CLAUDE.md "Local FS at
# ACE_VIDEOS_ROOT is render scratch only"). Anything under runs/<id>/
# is re-derivable from a fresh hydrate + render OR a Drive fetch via
# the lazy-pull path. Keeping it untracked stops every render +
# every Drive edit from showing up in `git status`. `global_style.yaml`
# at programs/ root stays tracked — that's the global template.
video-production/connect-videos/programs/*/runs/

# Clip-cache: video-production/scripts/build-clip-explorer.ts symlinks each
# @alias.mp4 into ~/.cache/connect-videos/<driveId>.<ext>. apps/videos/api.py
# detects the broken symlink (host-cache path doesn't exist in the Django
# container) and re-fetches the asset into <videos_root>/assets/clip-cache/
# via the workspace's Drive SA. Pure on-disk cache — every entry is
# re-derivable from Drive on demand. See CLAUDE.md "Editor visual caveats".
video-production/connect-videos/assets/clip-cache/
