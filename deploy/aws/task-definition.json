{
  "family": "labs-jj-ace-web",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::858923557655:role/labs-jj-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::858923557655:role/labs-jj-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "858923557655.dkr.ecr.us-east-1.amazonaws.com/labs-jj-ace-web:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "DJANGO_SETTINGS_MODULE",
          "value": "config.settings.connectlabs"
        },
        {
          "name": "DJANGO_DEBUG",
          "value": "False"
        },
        {
          "name": "DJANGO_ALLOWED_HOSTS",
          "value": "labs.connect.dimagi.com,localhost"
        },
        {
          "name": "CONNECT_PRODUCTION_URL",
          "value": "https://connect.dimagi.com"
        },
        {
          "name": "FORCE_SCRIPT_NAME",
          "value": "/ace"
        },
        {
          "name": "SECURE_SSL_REDIRECT",
          "value": "False"
        },
        {
          "name": "CSRF_TRUSTED_ORIGINS",
          "value": "https://labs.connect.dimagi.com"
        },
        {
          "name": "ACE_WEB_BASE_URL",
          "value": "https://labs.connect.dimagi.com/ace"
        },
        {
          "name": "ACE_ALLOWED_EMAIL_DOMAINS",
          "value": "dimagi.com,dimagi-ai.com,dimagi-associate.com"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "ACE_MOBILE_AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "ACE_MOBILE_INSTANCE_ID",
          "value": "i-0c447ed51374a4871"
        },
        {
          "name": "ACE_MOBILE_S3_BUCKET",
          "value": "ace-mobile-artifacts-labs"
        },
        {
          "name": "ACE_MOBILE_AMI_VERSION",
          "value": "2026-05-25-1857"
        },
        {
          "name": "CANOPY_BASE_URL",
          "value": "https://labs.connect.dimagi.com/canopy"
        },
        {
          "name": "CANOPY_PUBLIC_BASE_URL",
          "value": "/canopy"
        },
        {
          "name": "CANOPY_WORKSPACE",
          "value": "connect"
        },
        {
          "name": "CANOPY_AGENT_SLUG",
          "value": "ace"
        }
      ],
      "secrets": [
        {
          "name": "DJANGO_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:858923557655:secret:labs-jj-ace-web-django-secret-key-2XSt10"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:858923557655:secret:labs-jj-ace-web-database-url-5KLKYs"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:858923557655:secret:labs-jj-ace-web-redis-url-H4HN9I"
        },
        {
          "name": "CONNECT_OAUTH_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:858923557655:secret:labs-jj-ace-web-connect-oauth-client-id-jzsNCM"
        },
        {
          "name": "CONNECT_OAUTH_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:858923557655:secret:labs-jj-ace-web-connect-oauth-client-secret-kXQI9s"
        },
        {
          "name": "ACE_DRIVE_SA_KEY_JSON",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:858923557655:secret:labs-jj-ace-web-drive-sa-key-json-lIHSY8"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:858923557655:secret:labs-jj-ace-web-anthropic-api-key-x6p0ij"
        },
        {
          "name": "ACE_FIELD_ENCRYPTION_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:858923557655:secret:ace-web/field-encryption-key-D40eTj"
        },
        {
          "name": "OP_SERVICE_ACCOUNT_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:858923557655:secret:labs-jj-ace-web-op-service-account-token-aW4N8Y"
        },
        {
          "name": "SLACK_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:858923557655:secret:labs-jj-ace-web-slack-client-id-tNVN7G"
        },
        {
          "name": "SLACK_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:858923557655:secret:labs-jj-ace-web-slack-client-secret-KaEozS"
        },
        {
          "name": "SLACK_SIGNING_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:858923557655:secret:labs-jj-ace-web-slack-signing-secret-9CmCYh"
        },
        {
          "name": "CANOPY_APP_CREDENTIAL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:858923557655:secret:ace-web/canopy-app-credential-cbuXNb"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/labs-jj-ace-web",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8000/api/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    },
    {
      "name": "web",
      "image": "858923557655.dkr.ecr.us-east-1.amazonaws.com/labs-jj-ace-web-frontend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "dependsOn": [
        {
          "containerName": "api",
          "condition": "HEALTHY"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/labs-jj-ace-web",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "web",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
