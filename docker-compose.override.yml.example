# docker-compose override — per-developer local dev tweaks.
#
# Compose auto-loads `docker-compose.override.yml` (no flag needed) and
# merges it with the base `docker-compose.yml`. The override file is
# gitignored so each developer can opt into the snippets here without
# polluting the shared compose.
#
# To use: copy this file to `docker-compose.override.yml`, edit, then
#   docker compose up
#
# ───────────────────────────────────────────────────────────────────
# Live-mount the ACE plugin checkout
# ───────────────────────────────────────────────────────────────────
# By default the container reads the plugin from `/app/vendor/ace`,
# which is a snapshot baked into the image at build time. To pick up
# plugin changes without rebuilding, bind-mount your host checkout
# over that path AND add `/app/vendor/ace` to uvicorn's --reload-dir
# so file edits trigger a process restart (which wipes the
# `@functools.cache` on `apps/system/reader.load_system_overview`).
#
# Tradeoff: the host checkout's `node_modules/` (or lack thereof)
# overlays the image's vendored deps — fine when running with
# ACE_USE_FAKE_CLI_BACKEND=True (default in dev) since no MCP server
# is spawned. If you need to talk to real MCP servers locally, also
# `npm install` inside the host plugin dir.

services:
  app:
    volumes:
      # ABSOLUTE path on the host. Replace with your checkout location.
      - /Users/CHANGEME/emdash/repositories/ace:/app/vendor/ace
      # ───────────────────────────────────────────────────────────────
      # Resolve connect-videos clip-explorer media symlinks
      # ───────────────────────────────────────────────────────────────
      # `npm run hydrate -- --program=<slug>` materialises clips to
      # ~/.cache/connect-videos/<gdrive-id>.mp4 on the HOST and then
      # `build-clip-explorer` symlinks them into
      # video-production/connect-videos/out/clip-explorer/<slug>/media/
      # using ABSOLUTE paths. Mount the host cache dir at the same
      # absolute path inside the container so those symlinks resolve
      # when Django serves /api/w/<ws>/videos/.../media/<name>.mp4.
      # The destination path must literally match the symlink target,
      # so replace CHANGEME with your macOS username (cat /Users/$USER).
      - /Users/CHANGEME/.cache/connect-videos:/Users/CHANGEME/.cache/connect-videos:ro
      # ALSO mount the same cache at the container user's home so the
      # video-production scripts' defaultCacheDir() = os.homedir() + ...
      # resolves to the same bytes when running renders inside the
      # container (defaultCacheDir picks /home/app/.cache/... on Linux).
      # Without this, `npm run render` from Django's trigger_rerender
      # aborts with "6 asset(s) missing from cache" even though the host
      # cache is populated.
      - /Users/CHANGEME/.cache/connect-videos:/home/app/.cache/connect-videos:ro
    environment:
      # Docker Desktop on macOS doesn't propagate inotify events from the
      # host into the container for bind-mounted volumes — file CONTENT is
      # consistent (the read sees the latest bytes) but the kernel events
      # aren't fired. Force watchfiles to fall back to polling so plugin
      # edits actually trigger uvicorn's --reload. Polling cadence is ~1s
      # by default, which is fine for an interactive dev loop.
      WATCHFILES_FORCE_POLLING: "true"
    command: >
      uvicorn config.asgi:application
      --host 0.0.0.0 --port 8000
      --reload
      --reload-dir /app/apps
      --reload-dir /app/config
      --reload-dir /app/vendor/ace
      --reload-include "*.py"
      --reload-include "*.md"
      --reload-include "*.ts"
      --reload-include "*.yaml"
      --reload-include "*.yml"
