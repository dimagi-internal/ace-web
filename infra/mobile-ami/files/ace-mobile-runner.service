[Unit]
Description=ACE mobile emulator runner
Documentation=https://github.com/dimagi/ace-web/tree/main/infra/mobile-ami
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=ANDROID_SDK_ROOT=/opt/android-sdk
Environment=ANDROID_HOME=/opt/android-sdk
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/emulator:/opt/android-sdk/cmdline-tools/latest/bin

# Launch via the wrapper script which reads /opt/ace/states.yaml for the
# default state, exec's the emulator with the matching snapshot, and
# kicks off a self-heal probe in the background that installs CommCare
# if it's somehow missing post-boot. ace-web can stop this unit and
# restart it with a different state via SSM (see EmulatorController.select_state).
ExecStart=/usr/local/bin/ace-emulator-launch

# Auto-recover from a launch-script crash a bounded number of times
# before giving up. A non-zero exit (qemu died, registration recipe
# failed, adb wedge) triggers a clean restart after 10s. After 3
# failed starts within 120s the unit stays in `failed` state — at
# that point ace-web's /api/mobile/ensure-running or restart-runner
# endpoints are the explicit operator path (and call
# `systemctl reset-failed` via _runner_clean_restart_commands).
#
# An explicit `systemctl stop` (used by select_state and the recovery
# path) is a clean termination and does NOT trigger Restart — only
# non-zero exits do. The idle-shutdown timer powers the whole instance
# off rather than killing the unit, so it doesn't interact either.
Restart=on-failure
RestartSec=10
StartLimitBurst=3
StartLimitIntervalSec=120

StandardOutput=append:/var/log/ace-mobile/runner.log
StandardError=append:/var/log/ace-mobile/runner.log

# Tighten the runtime a notch.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
