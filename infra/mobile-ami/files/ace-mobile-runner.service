[Unit]
Description=ACE mobile emulator runner
Documentation=https://github.com/dimagi/ace-web/tree/main/infra/mobile-ami
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=ANDROID_SDK_ROOT=/opt/android-sdk
Environment=ANDROID_HOME=/opt/android-sdk
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/emulator:/opt/android-sdk/cmdline-tools/latest/bin

# Boot from the registered-test-user snapshot. -no-snapshot-save means
# the snapshot is read-only — process state during a session never
# leaks into the AMI baseline.
ExecStart=/opt/android-sdk/emulator/emulator \
  -avd ACE_Pixel_API_34 \
  -no-window \
  -no-audio \
  -no-boot-anim \
  -gpu swiftshader_indirect \
  -no-snapshot-save \
  -snapshot registered-test-user

# After ExecStart exits we're done — no automatic restart. ace-web's
# /api/mobile/ensure-running will start the EC2 instance afresh, which
# triggers this unit again on next boot.
Restart=no

StandardOutput=append:/var/log/ace-mobile/runner.log
StandardError=append:/var/log/ace-mobile/runner.log

# Tighten the runtime a notch.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
